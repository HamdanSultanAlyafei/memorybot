# MemoryBot — Environment Variables
# Copy this file to .env and fill in your values
# 
# ── Groq (FREE) ────────────────────────────────────────────────────────────────
# Sign up free at https://console.groq.com → API Keys → Create API Key
# No credit card required. 14,400 free requests/day.
GROQ_API_KEY=gsk_...

# ── Pinecone ───────────────────────────────────────────────────────────────────
# Get yours at https://app.pinecone.io/ (free Serverless tier)
PINECONE_API_KEY=pcsk_...

# Name of the Pinecone index (auto-created on first run)
PINECONE_INDEX_NAME=memorybot-memories

# ── App Settings ───────────────────────────────────────────────────────────────
BUFFER_WINDOW_K=6
PINECONE_TOP_K=3
SUMMARIZE_EVERY=10
SQLITE_DB_PATH=memorybot.db
